{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"layout": {
			"contentSize": "720px",
			"wideSize": "1140px"
		},
		"color": {
			"palette": [
				{ "slug": "primary", "color": "#007bff", "name": "Primary" },
				{ "slug": "secondary", "color": "#6c757d", "name": "Secondary" },
				{ "slug": "dark", "color": "#212529", "name": "Dark" },
				{ "slug": "light", "color": "#f8f9fa", "name": "Light" },
				{ "slug": "white", "color": "#ffffff", "name": "White" }
			]
		},
		"spacing": {
			"units": [ "px", "%", "rem", "em" ]
		},
		"typography": {
			"fontSizes": [
				{ "slug": "small", "size": "0.875rem", "name": "Small" },
				{ "slug": "base", "size": "1rem", "name": "Base" },
				{ "slug": "medium", "size": "1.25rem", "name": "Medium" },
				{ "slug": "large", "size": "1.5rem", "name": "Large" },
				{ "slug": "x-large", "size": "1.75rem", "name": "Extra Large" },
				{ "slug": "xx-large", "size": "2rem", "name": "XX Large" },
				{ "slug": "xxx-large", "size": "2.5rem", "name": "XXX Large" }
			]
		}
	}
}
